// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  VEHICLE_OWNER
  DRIVER
}

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum LicenseType {
  CLASS_A
  CLASS_B
  CLASS_C
  CLASS_D
  CLASS_E
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum DocumentType {
  VEHICLE_REGISTRATION
  INSURANCE
  INSPECTION
}

enum VehicleType {
  TRUCK
  VAN
  TRAILER
  OTHER
}

enum CapacityUnit {
  TON
  KG
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AssignmentStatus {
  PENDING
  ACTIVE
  ENDED
}

enum JobStatus {
  DRAFT
  PENDING_ASSIGNMENT
  ASSIGNED
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
}

enum JobPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TripStatus {
  SCHEDULED
  STARTED
  IN_TRANSIT
  ARRIVED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

// ─────────────────────────────────────────────
// User Model
// ─────────────────────────────────────────────

model User {
  id              String        @id @default(uuid())
  firstName       String
  middleName      String
  lastName        String
  email           String        @unique
  phoneNumber     String        @unique
  passwordHash    String
  role            Role
  accountStatus   AccountStatus @default(PENDING)
  emailVerified   Boolean       @default(false)
  profileImageUrl String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  driverProfile        DriverProfile?
  refreshTokens        RefreshToken[]
  emailVerifyTokens    EmailVerificationToken[]
  passwordResetTokens  PasswordResetToken[]
  vehicles             Vehicle[]
  profileChangeRequests ProfileChangeRequest[]
  driverAssignments    VehicleAssignment[] @relation("DriverAssignments")
  madeAssignments      VehicleAssignment[] @relation("AssignedBy")
  jobsCreated          TransportJob[]      @relation("JobsCreated")
  driverJobs           TransportJob[]      @relation("DriverJobs")
  driverTrips          Trip[]              @relation("DriverTrips")
  auditLogs            AuditLog[]

  @@map("users")
}

// ─────────────────────────────────────────────
// Driver Profile Model
// ─────────────────────────────────────────────

model DriverProfile {
  id                String      @id @default(uuid())
  userId            String      @unique
  licenseNumber     String      @unique
  licenseType       LicenseType
  licenseExpiryDate DateTime
  licenseDocumentUrl String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("driver_profiles")
}

// ─────────────────────────────────────────────
// Refresh Token Model
// ─────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// Email Verification Token Model
// ─────────────────────────────────────────────

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

// ─────────────────────────────────────────────
// Password Reset Token Model
// ─────────────────────────────────────────────

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────
// Vehicle Model
// ─────────────────────────────────────────────

model Vehicle {
  id                String         @id @default(uuid())
  ownerId           String
  plateNumber       String         @unique
  vehicleType       VehicleType
  brand             String
  model             String
  manufacturingYear Int
  capacity          Float
  capacityUnit      CapacityUnit
  vehicleStatus     VehicleStatus  @default(ACTIVE)
  approvalStatus    ApprovalStatus @default(PENDING)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Relations
  owner             User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  documents         VehicleDocument[]
  assignments       VehicleAssignment[]
  jobs              TransportJob[]    @relation("VehicleJobs")
  trips             Trip[]            @relation("VehicleTrips")

  @@map("vehicles")
}

// ─────────────────────────────────────────────
// Vehicle Document Model
// ─────────────────────────────────────────────

model VehicleDocument {
  id           String       @id @default(uuid())
  vehicleId    String
  documentType DocumentType
  documentUrl  String
  uploadedAt   DateTime     @default(now())

  // Relations
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_documents")
}

// ─────────────────────────────────────────────
// Profile Change Request Model
// ─────────────────────────────────────────────

model ProfileChangeRequest {
  id          String               @id @default(uuid())
  userId      String
  firstName   String
  middleName  String?
  lastName    String
  phoneNumber String
  status      ChangeRequestStatus  @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  // Relations
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile_change_requests")
}

// ─────────────────────────────────────────────
// Vehicle Assignment Model
// ─────────────────────────────────────────────

model VehicleAssignment {
  id              String            @id @default(uuid())
  vehicleId       String
  driverId        String
  assignedById    String
  status          AssignmentStatus  @default(ACTIVE)
  assignedAt      DateTime          @default(now())
  endedAt         DateTime?
  
  // Relations
  vehicle         Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver          User              @relation("DriverAssignments", fields: [driverId], references: [id], onDelete: Cascade)
  assignedBy      User              @relation("AssignedBy", fields: [assignedById], references: [id])

  @@map("vehicle_assignments")
}

// ─────────────────────────────────────────────
// Transport Job Model
// ─────────────────────────────────────────────

model TransportJob {
  id                  String        @id @default(uuid())
  referenceNumber     String        @unique
  createdById         String
  vehicleId           String?
  driverId            String?
  customerName        String?
  customerPhone       String?
  pickupLocation      String
  destination         String
  loadDescription     String
  loadType            String
  loadWeight          Float
  loadUnit            CapacityUnit  @default(TON)
  itemCount           Int?
  specialInstructions String?
  plannedPickupDate   DateTime?
  expectedDeliveryDate DateTime?
  priority            JobPriority   @default(MEDIUM)
  status              JobStatus     @default(PENDING_ASSIGNMENT)
  cancellationReason  String?
  cancelledAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Relations
  createdBy           User          @relation("JobsCreated", fields: [createdById], references: [id])
  vehicle             Vehicle?      @relation("VehicleJobs", fields: [vehicleId], references: [id])
  driver              User?         @relation("DriverJobs", fields: [driverId], references: [id])
  trips               Trip[]

  @@map("transport_jobs")
}

// ─────────────────────────────────────────────
// Trip Model
// ─────────────────────────────────────────────

model Trip {
  id                  String        @id @default(uuid())
  referenceNumber     String        @unique
  jobId               String
  vehicleId           String
  driverId            String
  status              TripStatus    @default(SCHEDULED)
  pickupLocation      String
  destination         String
  plannedDeparture    DateTime?
  actualDeparture     DateTime?
  expectedArrival     DateTime?
  actualArrival       DateTime?
  startingOdometer    Float?
  endingOdometer      Float?
  distanceTravelled   Float?
  notes               String?
  cancellationReason  String?
  cancelledAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Relations
  job                 TransportJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  vehicle             Vehicle       @relation("VehicleTrips", fields: [vehicleId], references: [id])
  driver              User          @relation("DriverTrips", fields: [driverId], references: [id])
  delivery            Delivery?

  @@map("trips")
}

// ─────────────────────────────────────────────
// Delivery Model
// ─────────────────────────────────────────────

model Delivery {
  id                  String         @id @default(uuid())
  tripId              String         @unique
  status              DeliveryStatus @default(DELIVERED)
  deliveredAt         DateTime       @default(now())
  receiverName        String
  receiverPhone       String?
  notes               String?
  proofDocumentUrl    String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relations
  trip                Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("deliveries")
}

// ─────────────────────────────────────────────
// Audit Log Model
// ─────────────────────────────────────────────

model AuditLog {
  id                  String        @id @default(uuid())
  userId              String?
  action              String
  entityType          String
  entityId            String
  details             String?
  createdAt           DateTime      @default(now())

  // Relations
  user                User?         @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
