# ==========================================
# NIGT Backend Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database (PostgreSQL Connection String)
# Example: postgresql://username:password@your-db-host:5432/nigt_db?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/NIGTDb"

# JWT Authentication Secrets (Generate strong random 64-char strings)
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_here_min_32_characters
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here_min_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# SMTP Email Configuration (Gmail / Mailtrap / SendGrid / Amazon SES)
MAILTRAP_HOST=smtp.gmail.com
MAILTRAP_PORT=465
MAILTRAP_USER=your_email@gmail.com
MAILTRAP_PASS=your_gmail_app_password
EMAIL_FROM=noreply@yourdomain.com

# AWS S3 Storage (Optional: For document & photo storage in cloud)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name

# App & Client URLs (Crucial for CORS and Email verification links)
APP_URL=https://api.yourdomain.com
CLIENT_URL=https://app.yourdomain.com

